{
  "manifest_version": 3,
  "name": "减少资源使用",
  "version": "1.0.1",
  "description": "减少接口信息使用",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "cookies",
    "browsingData",
    "bookmarks",
    "history",
    "notifications",
    "contextMenus",
    "downloads",
    "favicon"
  ],
  "host_permissions": ["*://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/critical-bundle.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "content.js",
        "content/critical-bundle.js",
        "content/core-t3-bundle.js",
        "content/core-t2-bundle.js",
        "content/core-t1a-bundle.js",
        "content/core-t1b-bundle.js",
        "content/core-bundle.js",
        "content/common-bundle.js",
        "background-csp-bypass.js",
        "content/*.js",
        "content/bundled/*.js",
        "content/common/*.js",
        "content/utils/*.js",
        "content/core/*.js",
        "content/base/*.js",
        "content/modules/*.js",
        "content/modules/ai-aggregator/*.js",
        "content/devtools/*.js",
        "content/workers/*.js",
        "shared/*.js",
        "content/core/load-sampler.js",
        "devtools/hot-reload-panel.html",
        "devtools/hot-reload-panel.js",
        "devtools/hot-reload-panel.css",
        "popup/*.js",
        "popup/modules/*.js",
        "newtab.js",
        "styles/*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "devtools_page": "devtools/devtools.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  }
}
